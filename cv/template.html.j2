<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ p.name }} — {{ v.headline }}</title>
<style>
/* One column, real text, standard section names: what applicant-tracking
   systems parse reliably and what a recruiter scans in six seconds. */
@font-face { font-family: "Archivo"; src: url("{{ fonts }}/Archivo[wdth,wght].ttf"); font-weight: 100 900; }
@font-face { font-family: "Public Sans"; src: url("{{ fonts }}/PublicSans[wght].ttf"); font-weight: 100 900; }
@page { size: A4; margin: 12mm 14mm 11mm; }
:root { --ink: #1F3B44; --muted: #4E6770; --accent: #2E6B5E; --rule: #D9CFBF; }
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: "Public Sans", sans-serif; font-size: 9.5pt; line-height: 1.42; color: var(--ink); }
strong { font-weight: 600; }
a { color: inherit; text-decoration: none; }
header { margin-bottom: 7pt; }
h1 { font-family: "Archivo", sans-serif; font-size: 20pt; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
.headline { font-family: "Archivo", sans-serif; font-size: 11.5pt; font-weight: 600; color: var(--accent); margin-top: 1pt; }
.contact { color: var(--muted); font-size: 8.5pt; margin-top: 4pt; }
.contact span + span::before { content: "·"; margin: 0 5pt; color: var(--rule); }
.summary { margin: 6pt 0 2pt; color: var(--ink); }
h2 { font-family: "Archivo", sans-serif; font-size: 9pt; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
     color: var(--accent); border-bottom: 0.8pt solid var(--rule); padding-bottom: 2pt; margin: 9pt 0 5pt; }
.item { margin-bottom: 5pt; break-inside: avoid; }
.row { display: flex; justify-content: space-between; align-items: baseline; gap: 10pt; }
.role { font-family: "Archivo", sans-serif; font-weight: 700; font-size: 10pt; }
.official { font-family: "Public Sans", sans-serif; font-weight: 400; font-size: 8.5pt; color: var(--muted); }
.meta { color: var(--muted); font-size: 8.5pt; white-space: nowrap; }
.org { color: var(--muted); font-size: 8.8pt; }
ul { margin: 2pt 0 0 11pt; }
li { margin-bottom: 1.6pt; padding-left: 1pt; }
li::marker { color: var(--accent); }
.proj-name { font-weight: 700; }
.proj-url { color: var(--accent); font-size: 8.3pt; text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 1.5pt; }
.skills { display: grid; grid-template-columns: max-content 1fr; column-gap: 10pt; row-gap: 2pt; }
.skills dt { font-weight: 600; }
.edu .row + .row { margin-top: 3pt; }
.small { font-size: 8.6pt; color: var(--muted); }
</style>
</head>
<body>
<header>
  <h1>{{ p.name }}</h1>
  <div class="headline">{{ v.headline }}</div>
  <div class="contact">
    <span>{{ p.location }}</span><span><a href="mailto:{{ p.email }}">{{ p.email }}</a></span><span>{{ p.phone }}</span>
  </div>
  <div class="contact">
    <span><a href="https://{{ p.portfolio }}">{{ p.portfolio }}</a></span><span><a href="https://{{ p.linkedin }}">{{ p.linkedin }}</a></span><span><a href="https://{{ p.github }}">{{ p.github }}</a></span>
  </div>
  <p class="summary">{{ v.summary | md }}</p>
</header>

<h2>Experience</h2>
{% for job in jobs %}
<div class="item">
  <div class="row">
    <div><span class="role">{{ job.title }}</span>{% if job.official_title %} <span class="official">(official title: {{ job.official_title }})</span>{% endif %}</div>
    <div class="meta">{{ job.dates }}</div>
  </div>
  <div class="row"><div class="org">{{ job.company }}</div><div class="meta">{{ job.where }}</div></div>
  <ul>{% for b in job.picked %}<li>{{ b | md }}</li>{% endfor %}</ul>
</div>
{% endfor %}

<h2>Projects</h2>
{% for pr in projects %}
<div class="item">
  <div><span class="proj-name">{{ pr.name }}</span> · <a class="proj-url" href="https://{{ pr.url }}">case study</a> · <a class="proj-url" href="https://{{ pr.repo }}">{{ pr.repo }}</a></div>
  <div>{{ pr.text | md }}</div>
</div>
{% endfor %}

<h2>Skills</h2>
<dl class="skills">
{% for label, items in skills %}<dt>{{ label }}</dt><dd>{{ items }}</dd>
{% endfor %}</dl>

<h2>Education</h2>
<div class="edu">
{% for e in education %}
  <div class="row"><div><strong>{{ e.degree }}</strong> · {{ e.school }}</div>{% if e.dates %}<div class="meta">{{ e.dates }}</div>{% endif %}</div>
  {% if e.note %}<div class="small">{{ e.note }}</div>{% endif %}
{% endfor %}
</div>

{% if x.certifications %}<h2>Certifications</h2>
<div>{{ x.certifications }}</div>{% endif %}
<h2>Languages</h2>
<div>{{ x.languages }}</div>
</body>
</html>
